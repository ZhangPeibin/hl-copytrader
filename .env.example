# ---- network ----
HL_NETWORK=mainnet

# ---- security ----
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HL_SECRET_ENC_KEY=
# 可选：留空则仅绑定 127.0.0.1
APP_PASSWORD=

# ---- runtime ----
DATA_DIR=/data
LOG_LEVEL=INFO
TZ=Asia/Shanghai

# ---- engine tuning ----
RECONCILE_INTERVAL_SEC=30
LEADER_CACHE_TTL_SEC=2
MAX_SLIPPAGE_DEFAULT=0.01
